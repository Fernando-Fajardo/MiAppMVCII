<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiAppMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        /* Fondo base tecnológico y tipografía */
        body {
            background-color: #0b111e;
            background-image: radial-gradient(circle at 50% 50%, #111a2e 0%, #070b14 100%);
            color: #e2e8f0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar estilo HUD transparente */
        .navbar-tech {
            background: rgba(11, 17, 30, 0.8) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0, 180, 216, 0.15);
        }

        .navbar-tech .navbar-brand {
            color: #00b4d8 !important;
            font-weight: bold;
            letter-spacing: 1px;
            text-shadow: 0 0 10px rgba(0, 180, 216, 0.3);
        }

        .navbar-tech .nav-link {
            color: #94a3b8 !important;
            transition: color 0.3s ease;
        }

        .navbar-tech .nav-link:hover {
            color: #00f5ff !important;
        }

        /* Footer Tecnológico */
        footer {
            background: rgba(7, 11, 20, 0.9);
            border-top: 1px solid rgba(0, 180, 216, 0.1);
            color: #64748b;
            padding: 15px 0;
            margin-top: auto;
        }

        footer a {
            color: #38bdf8;
            text-decoration: none;
        }
        footer a:hover {
            color: #00f5ff;
            text-shadow: 0 0 8px rgba(0, 245, 255, 0.5);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-tech box-shadow mb-3">
            <div class="container-fluid mx-5">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MiAppMVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 d-flex align-items-center justify-content-center">
        <main role="main" class="w-100 pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="background: rgba(15, 23, 42, 0.8); border-color: rgba(255,255,255,0.1) !important;">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center py-2 text-center" style="font-size: 0.85rem;">
                <div class="mb-2 mb-md-0">
                    &copy; 2026 - MiAppMVC
                </div>
                <div class="d-flex gap-3 justify-content-center">
                    <a class="text-decoration-none text-info" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <span class="text-secondary opacity-50">|</span>
                    <a class="text-decoration-none text-info" href="#">Contact</a>
                    <span class="text-secondary opacity-50">|</span>
                    <a class="text-decoration-none text-info" href="#">Status</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>