@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    <div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-lg border border-primary">
        <div class="container-fluid py-5">
            <h1 class="display-3 fw-bold text-gradient">APP DE FERNANDO FAJARDO</h1>
            <p class="col-md-8 fs-4 mx-auto text-light opacity-75">
                Laboratorio de Contenedores y Redes Virtuales
            </p>
            <hr class="my-4 bg-primary style-hr">
            <div class="d-flex justify-content-center gap-3">
                <span class="badge bg-primary px-3 py-2 fs-6">ASP.NET Core 10.0</span>
                <span class="badge bg-info text-dark px-3 py-2 fs-6">Docker Ready</span>
                <span class="badge bg-success px-3 py-2 fs-6">CentOS VM</span>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gradient {
        background: linear-gradient(45deg, #3a7bd5, #3a6073);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .style-hr {
        height: 3px;
        border: none;
        width: 50%;
        margin: 0 auto;
    }
</style>