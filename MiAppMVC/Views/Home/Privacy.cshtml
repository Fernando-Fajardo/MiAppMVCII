@{
    ViewData["Title"] = "Acerca del Proyecto";
}
<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-body p-5 text-center" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white;">
            <h1 class="display-4 font-weight-bold mb-3">Laboratorio de Contenedores y Redes Virtuales</h1>
            <p class="lead text-white-50">Despliegue de Aplicaciones de Última Generación con ASP.NET Core y Docker</p>
        </div>
        <div class="card-body p-5 text-dark">
            <h3 class="text-primary mb-4 border-bottom pb-2">Propósito del Sistema</h3>
            <p class="card-text text-muted" style="font-size: 1.15rem; line-height: 1.8;">
                Esta aplicación web ha sido desarrollada bajo el patrón arquitectónico <strong>Modelo-Vista-Controlador (MVC)</strong> utilizando la tecnología de vanguardia <strong>.NET 10.0</strong>. El objetivo principal de este proyecto es demostrar la correcta implementación del ciclo de vida de un contenedor de software, abarcando desde el diseño de un entorno de compilación multi-etapa (Multi-stage build) hasta su orquestación y exposición segura en redes virtuales dentro de un entorno de servidor robusto como lo es <strong>CentOS Linux</strong>.
            </p>

            <div class="row mt-5">
                <div class="col-md-6 mb-4">
                    <div class="p-4 border rounded shadow-sm bg-light">
                        <h5 class="text-secondary font-weight-bold"><i class="bi bi-cpu"></i> Arquitectura Utilizada</h5>
                        <ul class="list-unstyled text-muted mt-3">
                            <li>✔ ASP.NET Core 10.0 MVC</li>
                            <li>✔ Docker Engine (Multi-stage Build)</li>
                            <li>✔ Servidor Virtual CentOS Linux</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="p-4 border rounded shadow-sm bg-light">
                        <h5 class="text-secondary font-weight-bold"><i class="bi bi-person-badge"></i> Desarrollador</h5>
                        <p class="text-muted mt-3 mb-1"><strong>Nombre:</strong> Fernando Fajardo</p>
                        <p class="text-muted"><strong>Rol:</strong> Ingeniero de Software / Administrador de Sistemas</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-center text-muted bg-white border-0 pb-4">
            <small>© 2026 - Fernando Fajardo. Todos los derechos reservados.</small>
        </div>
    </div>
</div>